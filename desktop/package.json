{
  "name": "tarvio-desktop",
  "version": "1.0.0",
  "description": "Tarvio — versione PC (Electron)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "app.tarvio.desktop",
    "productName": "Tarvio",
    "files": [
      "main.js",
      "preload.js",
      "build/icon.png",
      {
        "from": "../www",
        "to": "www",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../ia",
        "to": "ia",
        "filter": [
          "**/*",
          "!bin/**"
        ]
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": "AppImage"
    },
    "mac": {
      "target": "dmg"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
